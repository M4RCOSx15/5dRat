<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M12: libs exigidas pelo backend GPU do LiteRT-LM (docs oficiais).
         required="false" mantém instalação em devices sem OpenCL. -->
    <application>
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>
</manifest>
